# Copy to .env and fill in. Never commit real values.

# PostgreSQL (see README: local setup)
DATABASE_URL="postgresql://woman_cares:CHANGE_ME@localhost:5432/woman_cares_dev?schema=public"
TEST_DATABASE_URL="postgresql://woman_cares:CHANGE_ME@localhost:5432/woman_cares_test?schema=public"

# Public base URL (used for metadata, CSRF origin checks, email links)
APP_URL="http://localhost:3000"

# 32+ random bytes, e.g. `openssl rand -base64 32`. Signs view-analytics hashes and session IP hashes.
AUTH_SECRET=""

# Only for `npm run admin:create` in non-interactive environments (otherwise the password is prompted).
# SUPER_ADMIN_PASSWORD=""

# Email: "log" prints messages to the server console (development); "smtp" sends for real.
EMAIL_TRANSPORT="log"
EMAIL_FROM="Woman Cares <no-reply@example.com>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# Media storage: "local" writes under STORAGE_LOCAL_DIR; "cloudinary" for hosts with no writable
# disk (Vercel). With "cloudinary", set CLOUDINARY_URL and leave PUBLIC_MEDIA_BASE_URL empty unless
# you serve the CDN from your own domain.
STORAGE_DRIVER="local"
# cloudinary://<api_key>:<api_secret>@<cloud_name>  (Cloudinary dashboard → API Environment variable)
CLOUDINARY_URL=""
STORAGE_LOCAL_DIR=".storage"
PUBLIC_MEDIA_BASE_URL="/uploads"
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET_PUBLIC=""
S3_BUCKET_PRIVATE=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Shared secret for the daily job at /api/cron/daily (Vercel Cron sends it as a Bearer token).
# Without it the route refuses every caller, so it can never run unprotected.
CRON_SECRET=""

# Subscription payments: "manual" (admin verification) until a gateway is configured.
PAYMENT_ADAPTER="manual"
